{
  "name": "football-simulator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Tableau tactique de football en réalité augmentée (PWA, WebXR, three.js).",
  "scripts": {
    "start": "node tests/serve.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import ./tests/unit/import-map.mjs --test",
    "test:e2e": "node tests/run-tests.mjs",
    "bench": "node tests/benchmark.mjs",
    "shell-version": "node tests/shell-version.mjs",
    "pages:prepare": "node tests/prepare-pages.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.1"
  },
  "engines": {
    "node": ">=18"
  }
}
